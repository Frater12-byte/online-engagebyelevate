{
  "name": "Engage - Online Signup Capture",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "engage-online-signup",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-signup",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "engage-online-signup"
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_YOUR_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Received At": "={{ $now.toISO() }}",
            "Signed Up At": "={{ $json.body.ts || '' }}",
            "Name": "={{ $json.body.name || '' }}",
            "Email": "={{ $json.body.email || '' }}",
            "Company": "={{ $json.body.company || '' }}",
            "User Agent": "={{ $json.body.ua || '' }}",
            "Referrer": "={{ $json.body.ref || '' }}"
          },
          "matchingColumns": [],
          "schema": [
            { "id": "Received At", "displayName": "Received At", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "Signed Up At", "displayName": "Signed Up At", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "Name", "displayName": "Name", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "Email", "displayName": "Email", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "Company", "displayName": "Company", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "User Agent", "displayName": "User Agent", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "Referrer", "displayName": "Referrer", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true }
          ]
        },
        "options": {}
      },
      "id": "sheets-append",
      "name": "Append to Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [480, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true }",
        "options": {}
      },
      "id": "respond-ok",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 300]
    },
    {
      "parameters": {
        "fromEmail": "Elevate World <hello@news.elevatedmc.com>",
        "toEmail": "={{ $('Webhook').item.json.body.email }}",
        "subject": "Welcome to Engage Online for Hotels — see you 2–4 June",
        "emailFormat": "html",
        "html": "=<div style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; max-width: 560px; color: #1a1a1f; line-height: 1.55; padding: 16px 0;\">\n  <h2 style=\"font-size: 22px; margin: 0 0 12px; color: #1a1a1f;\">Welcome to Engage Online — for Hotels</h2>\n  <p>Hi {{ $('Webhook').item.json.body.name }},</p>\n  <p>Thanks for signing up — <strong>{{ $('Webhook').item.json.body.company }}</strong> is confirmed for the hotels' online programme of <strong>Engage by Elevate 2026</strong>.</p>\n  <p style=\"margin: 20px 0;\"><a href=\"https://online.engagebyelevate.com/programme\" style=\"display: inline-block; padding: 12px 20px; background: #E8612A; color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600;\">View the live programme →</a></p>\n  <p>Sessions stream live from Dubai on Tuesday 2, Wednesday 3 and Thursday 4 June — keynotes, hotel showcases and tourism board presentations curated for hotels. Each Teams meeting opens 10 minutes before its scheduled start.</p>\n  <p><strong>One thing before you join:</strong> Microsoft Teams sessions require a Microsoft account, work or personal. If you don't have one, <a href=\"https://signup.live.com/\" style=\"color: #E8612A;\">create one for free</a> before the event starts.</p>\n  <p>If you have any questions, just reply to this email.</p>\n  <p style=\"margin-top: 24px;\">See you 2–4 June,<br><strong>The Engage by Elevate team</strong></p>\n  <p style=\"margin-top: 28px; padding-top: 16px; border-top: 1px solid #eee; font-size: 12px; color: #777;\">Elevate Tourism LLC · Dubai · <a href=\"https://engagebyelevate.com\" style=\"color: #777;\">engagebyelevate.com</a></p>\n</div>",
        "options": {
          "appendAttribution": false,
          "replyTo": "events@engagebyelevate.com"
        }
      },
      "id": "send-welcome",
      "name": "Send welcome email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [960, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[ { "node": "Append to Sheet", "type": "main", "index": 0 } ]]
    },
    "Append to Sheet": {
      "main": [[ { "node": "Respond OK", "type": "main", "index": 0 } ]]
    },
    "Respond OK": {
      "main": [[ { "node": "Send welcome email", "type": "main", "index": 0 } ]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "pinData": {},
  "versionId": "",
  "triggerCount": 0,
  "tags": []
}
